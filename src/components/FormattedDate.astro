---
import { DEFAULT_LOCALE, languages, type Locale } from '../lib/i18n';

interface Props {
	date: Date;
	locale?: Locale;
}

const { date, locale = DEFAULT_LOCALE } = Astro.props;
---

<time datetime={date.toISOString()}>
	{
		date.toLocaleDateString(languages[locale].html, {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
			timeZone: 'UTC',
		})
	}
</time>
