---
import '../styles/global.css';
import {
	DEFAULT_LOCALE,
	languages,
	type Locale,
	type LocaleLink,
} from '../lib/i18n';

interface Props {
	title: string;
	description: string;
	type?: 'website' | 'article';
	locale?: Locale;
	translations?: LocaleLink[];
}

const {
	title,
	description,
	type = 'website',
	locale = DEFAULT_LOCALE,
	translations = [],
} = Astro.props;
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const alternateURLs = translations.map((translation) => ({
	...translation,
	href: Astro.site ? new URL(translation.href, Astro.site) : translation.href,
}));
const defaultURL = alternateURLs.find(
	(translation) => translation.locale === DEFAULT_LOCALE,
);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#232136" />
<meta name="color-scheme" content="dark" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

{canonicalURL && <link rel="canonical" href={canonicalURL} />}
{
	alternateURLs.map((translation) => (
		<link
			rel="alternate"
			hreflang={languages[translation.locale].html}
			href={translation.href}
		/>
	))
}
{defaultURL && <link rel="alternate" hreflang="x-default" href={defaultURL.href} />}

<title>{title}</title>
<meta name="description" content={description} />

<meta property="og:type" content={type} />
{canonicalURL && <meta property="og:url" content={canonicalURL} />}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:locale" content={languages[locale].og} />
{
	alternateURLs
		.filter((translation) => translation.locale !== locale)
		.map((translation) => (
			<meta property="og:locale:alternate" content={languages[translation.locale].og} />
		))
}

<meta name="twitter:card" content="summary" />
