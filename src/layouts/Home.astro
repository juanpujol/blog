---
import type { CollectionEntry } from 'astro:content';
import { SITE_TITLE } from '../consts';
import {
	LOCALES,
	homeUrl,
	postUrl,
	slug,
	ui,
	type Locale,
} from '../lib/i18n';
import BaseLayout from './BaseLayout.astro';

interface Props {
	posts: CollectionEntry<'blog'>[];
	locale: Locale;
}

const { posts, locale } = Astro.props;
const copy = ui[locale];
const localeLinks = LOCALES.map((value) => ({
	locale: value,
	href: homeUrl(value),
}));
const path = locale === 'en' ? '~/notes' : `~/${locale}/notes`;
---

<BaseLayout
	title={SITE_TITLE}
	description={copy.description}
	path={path}
	locale={locale}
	translations={localeLinks}
>
	<div class="home-grid">
		<section class="intro pane" aria-labelledby="intro-title">
			<p class="command pane-label"><span aria-hidden="true">&gt;</span> whoami</p>
			<div class="identity">
				<h1 id="intro-title">Juan Pujol</h1>
				<p class="lede">{copy.description}</p>
			</div>
			<nav class="social-links" aria-label={copy.socials}>
				<a
					href="https://www.linkedin.com/in/juanpujol/"
					target="_blank"
					rel="me noopener"
					aria-label={copy.linkedin}
				>
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path
							d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
						></path>
					</svg>
				</a>
			</nav>
		</section>

		<section class="articles pane" aria-labelledby="articles-title">
			<div class="section-command pane-label">
				<span aria-hidden="true">&gt;</span>
				<h2 id="articles-title">ls -lt ./posts</h2>
			</div>

			{
				posts.length > 0 ? (
					<ol class="post-list">
						{posts.map((post) => (
							<li>
								<a href={postUrl(locale, slug(post))}>
									<time datetime={post.data.pubDate.toISOString()}>
										{post.data.pubDate.toISOString().slice(0, 10)}
									</time>
									<span class="post-copy">
										<strong>{post.data.title}</strong>
										<span>{post.data.description}</span>
									</span>
									<span class="open" aria-hidden="true">-&gt;</span>
								</a>
							</li>
						))}
					</ol>
				) : (
					<p class="empty-state">
						<span>total 0</span>
						{copy.empty}
					</p>
				)
			}
		</section>
	</div>
</BaseLayout>

<style>
	.home-grid {
		display: grid;
		grid-template-columns: minmax(18rem, 0.72fr) minmax(0, 1.35fr);
		min-height: min(42rem, calc(100vh - 9rem));
		border: 1px solid var(--border);
	}

	.pane {
		position: relative;
		min-width: 0;
	}

	.intro {
		display: flex;
		align-items: center;
		padding: clamp(3rem, 6vw, 5.5rem) clamp(1.5rem, 3vw, 3rem);
		border-right: 1px solid var(--border);
	}

	.identity {
		width: 100%;
	}

	.command,
	.section-command {
		color: var(--gold);
	}

	.command span,
	.section-command > span {
		color: var(--foam);
	}

	h1 {
		margin: 0;
		color: var(--text);
		font-size: clamp(2.8rem, 5vw, 4.8rem);
		letter-spacing: -0.075em;
		line-height: 1;
	}

	h1::after {
		display: inline-block;
		width: 0.12em;
		height: 0.8em;
		margin-left: 0.12em;
		background: var(--iris);
		content: '';
		vertical-align: -0.04em;
		animation: blink 1.1s steps(1) infinite;
	}

	.lede {
		margin: 1.75rem 0 0;
		color: var(--muted);
		font-size: clamp(1rem, 2.5vw, 1.2rem);
		line-height: 1.8;
	}

	.social-links {
		position: absolute;
		bottom: clamp(1.25rem, 2vw, 2rem);
		left: clamp(1.5rem, 3vw, 3rem);
		display: flex;
		gap: 0.5rem;
	}

	.social-links a {
		display: grid;
		width: 2.5rem;
		height: 2.5rem;
		border: 1px solid var(--border);
		color: var(--muted);
		place-items: center;
		transition:
			border-color 150ms ease,
			background-color 150ms ease,
			color 150ms ease;
	}

	.social-links a:hover {
		border-color: var(--foam);
		background: var(--highlight-low);
		color: var(--foam);
	}

	.social-links svg {
		width: 1.15rem;
		height: 1.15rem;
		fill: currentColor;
	}

	.articles {
		padding: 2.25rem 0;
	}

	.section-command h2 {
		margin: 0;
		color: var(--gold);
		font-size: inherit;
		letter-spacing: inherit;
	}

	.post-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.post-list li {
		border-top: 1px solid var(--border);
	}

	.post-list li:last-child {
		border-bottom: 1px solid var(--border);
	}

	.post-list a {
		display: grid;
		grid-template-columns: 8rem minmax(0, 1fr) auto;
		gap: 1.5rem;
		align-items: start;
		padding: 1.6rem clamp(1rem, 2.5vw, 2rem);
		color: inherit;
		text-decoration: none;
		transition: background-color 150ms ease;
	}

	.post-list a:hover,
	.post-list a:focus-visible {
		background: var(--highlight-low);
	}

	.post-list a:focus-visible {
		outline: 2px solid var(--iris);
		outline-offset: -2px;
	}

	.post-list time {
		padding-top: 0.2rem;
		color: var(--muted);
		font-size: 0.8rem;
		font-variant-numeric: tabular-nums;
	}

	.post-copy {
		display: grid;
		gap: 0.65rem;
	}

	.post-copy strong {
		color: var(--iris);
		font-size: clamp(1.15rem, 3vw, 1.5rem);
		letter-spacing: -0.03em;
		line-height: 1.35;
	}

	.post-copy > span {
		max-width: 44rem;
		color: var(--muted);
		font-size: 0.9rem;
		line-height: 1.7;
	}

	.open {
		padding-top: 0.1rem;
		color: var(--foam);
		font-weight: 700;
	}

	.empty-state {
		display: grid;
		gap: 1rem;
		margin: 0;
		padding: 2rem 1rem;
		border-block: 1px solid var(--border);
		color: var(--muted);
	}

	.empty-state span {
		color: var(--foam);
		font-size: 0.8rem;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		h1::after {
			animation: none;
		}
	}

	@media (max-width: 820px) {
		.home-grid {
			grid-template-columns: 1fr;
			min-height: auto;
		}

		.intro {
			min-height: 24rem;
			padding: 4rem clamp(1.25rem, 7vw, 3rem);
			border-right: 0;
			border-bottom: 1px solid var(--border);
		}

		h1 {
			font-size: clamp(2.8rem, 14vw, 4.5rem);
		}

		.articles {
			padding-top: 2.5rem;
		}

		.post-list a {
			grid-template-columns: 1fr auto;
			gap: 0.75rem 1rem;
			padding-inline: 1.25rem;
		}

		.post-list time {
			grid-column: 1 / -1;
		}
	}
</style>
