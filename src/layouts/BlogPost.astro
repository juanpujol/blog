---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { homeUrl, languages, postUrl, ui, type LocaleLink } from '../lib/i18n';
import BaseLayout from './BaseLayout.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	slug: string;
	translations: LocaleLink[];
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	slug,
	locale,
	translations,
} = Astro.props;
const copy = ui[locale];
const routePath = `~${postUrl(locale, slug)}`;
---

<BaseLayout
	title={title}
	description={description}
	path={routePath}
	type="article"
	locale={locale}
	translations={translations}
	pubDate={pubDate}
	updatedDate={updatedDate}
>
	<article class="article">
		<p class="pane-label">
			<span aria-hidden="true">&gt;</span>
			<span class="pane-path">{routePath}</span>
		</p>
		<div class="article-controls">
			<a class="back" href={homeUrl(locale)}>&lt;- cd ..</a>
			{
				translations.length > 1 && (
					<nav class="article-tabs" aria-label={copy.languages}>
						{translations.map((translation) => (
							<a
								href={translation.href}
								hreflang={languages[translation.locale].html}
								lang={languages[translation.locale].html}
								aria-current={translation.locale === locale ? 'page' : undefined}
							>
								{languages[translation.locale].label}
							</a>
						))}
					</nav>
				)
			}
		</div>

		<header class="article-header">
			<p class="meta">
				<span>{copy.published}</span>
				<FormattedDate date={pubDate} locale={locale} />
			</p>
			<h1>{title}</h1>
			<p class="description">{description}</p>
			{
				updatedDate && (
					<p class="updated">
						{copy.updated} <FormattedDate date={updatedDate} locale={locale} />
					</p>
				)
			}
		</header>

		<div class="prose">
			<slot />
		</div>
	</article>
</BaseLayout>

<style>
	.article {
		position: relative;
		max-width: 49rem;
		margin: 0 auto;
		padding: clamp(2rem, 4vw, 3rem) clamp(1.25rem, 6vw, 4.5rem)
			clamp(4rem, 9vw, 7rem);
		border: 1px solid var(--border);
	}

	.pane-label {
		color: var(--gold);
	}

	.article-controls {
		display: flex;
		gap: 1rem;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 1.5rem;
	}

	.back {
		display: inline-block;
		color: var(--foam);
		font-size: 0.85rem;
		font-weight: 700;
		text-decoration: none;
	}

	.back:hover {
		color: var(--gold);
	}

	.article-tabs {
		display: flex;
		width: max-content;
		max-width: 100%;
		border: 1px solid var(--border);
		background: var(--base-dark);
	}

	.article-tabs a {
		padding: 0.35rem 0.65rem;
		color: var(--muted);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-align: center;
		text-decoration: none;
	}

	.article-tabs a + a {
		border-left: 1px solid var(--border);
	}

	.article-tabs a:hover {
		background: var(--surface);
		color: var(--gold);
	}

	.article-tabs a[aria-current='page'] {
		background: var(--rose);
		color: var(--base-dark);
	}

	.article-header {
		margin-bottom: 3.5rem;
		padding-bottom: 2.5rem;
		border-bottom: 1px solid var(--border);
	}

	.meta {
		display: flex;
		gap: 0.75rem;
		margin: 0 0 1rem;
		color: var(--muted);
		font-size: 0.8rem;
		font-variant-numeric: tabular-nums;
	}

	.meta span {
		color: var(--gold);
	}

	h1 {
		margin: 0;
		color: var(--text);
		font-size: clamp(1.85rem, 6vw, 3.8rem);
		letter-spacing: -0.065em;
		line-height: 1.05;
	}

	.description {
		margin: 2rem 0 0;
		color: var(--muted);
		font-size: 1rem;
		line-height: 1.8;
	}

	.updated {
		margin: 1rem 0 0;
		color: var(--subtle);
		font-size: 0.75rem;
	}

	.prose {
		color: var(--text);
		font-size: clamp(0.95rem, 2vw, 1.05rem);
		line-height: 1.85;
	}

	.prose :global(h2),
	.prose :global(h3),
	.prose :global(h4) {
		color: var(--iris);
		letter-spacing: -0.04em;
		line-height: 1.3;
	}

	.prose :global(h2) {
		margin: 4rem 0 1.25rem;
		padding-left: 1rem;
		border-left: 2px solid var(--foam);
		font-size: clamp(1.6rem, 4vw, 2.15rem);
	}

	.prose :global(h3) {
		margin: 3rem 0 1rem;
		font-size: 1.35rem;
	}

	.prose :global(p) {
		margin: 0 0 1.75rem;
	}

	.prose :global(a) {
		color: var(--foam);
		text-decoration-color: var(--border);
		text-underline-offset: 0.25em;
	}

	.prose :global(a:hover) {
		color: var(--gold);
	}

	.prose :global(strong) {
		color: var(--rose);
	}

	.prose :global(ul),
	.prose :global(ol) {
		margin: 0 0 2rem;
		padding-left: 1.5rem;
	}

	.prose :global(li) {
		margin-bottom: 0.7rem;
		padding-left: 0.35rem;
	}

	.prose :global(li::marker) {
		color: var(--foam);
	}

	.prose :global(blockquote) {
		margin: 2.5rem 0;
		padding: 0.25rem 0 0.25rem 1.5rem;
		border-left: 2px solid var(--love);
		color: var(--muted);
	}

	.prose :global(blockquote p:last-child) {
		margin-bottom: 0;
	}

	.prose :global(code) {
		padding: 0.15em 0.4em;
		border: 1px solid var(--border);
		background: var(--surface);
		color: var(--gold);
		font: inherit;
		font-size: 0.9em;
	}

	.prose :global(pre) {
		overflow-x: auto;
		margin: 2.5rem 0;
		padding: 1.25rem;
		border: 1px solid var(--border);
		background: var(--base-dark) !important;
		line-height: 1.65;
	}

	.prose :global(pre code) {
		padding: 0;
		border: 0;
		background: transparent;
		color: inherit;
	}

	.prose :global(hr) {
		margin: 3.5rem 0;
		border: 0;
		border-top: 1px solid var(--border);
	}

	.prose :global(table) {
		display: block;
		overflow-x: auto;
		width: 100%;
		margin: 2.5rem 0;
		border-collapse: collapse;
		font-size: 0.85rem;
	}

	.prose :global(th),
	.prose :global(td) {
		padding: 0.75rem 1rem;
		border: 1px solid var(--border);
		text-align: left;
	}

	.prose :global(th) {
		color: var(--gold);
	}

	.prose :global(img) {
		display: block;
		max-width: 100%;
		height: auto;
		margin: 2.5rem auto;
		border: 1px solid var(--border);
	}

	@media (max-width: 640px) {
		.article {
			padding: 2.5rem 1.25rem 5rem;
			border-inline: 0;
			border-bottom: 0;
		}
	}
</style>
