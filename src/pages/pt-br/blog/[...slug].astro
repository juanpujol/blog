---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../../layouts/BlogPost.astro';
import {
	slug as entrySlug,
	translations as getTranslations,
	type LocaleLink,
} from '../../../lib/i18n';

interface Props {
	post: CollectionEntry<'blog'>;
	slug: string;
	translations: LocaleLink[];
}

export async function getStaticPaths() {
	const posts = await getCollection('blog');

	return posts
		.filter((post) => post.data.locale === 'pt-br')
		.map((post) => ({
			params: { slug: entrySlug(post) },
			props: {
				post,
				slug: entrySlug(post),
				translations: getTranslations(post, posts),
			},
		}));
}

const { post, slug, translations } = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data} slug={slug} translations={translations}>
	<Content />
</BlogPost>
