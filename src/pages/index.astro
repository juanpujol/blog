---
import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION} path="~/notes">
	<section class="intro" aria-labelledby="intro-title">
		<p class="command"><span aria-hidden="true">&gt;</span> whoami</p>
		<h1 id="intro-title">Juan Pujol</h1>
		<p class="lede">{SITE_DESCRIPTION}</p>
	</section>

	<section class="articles" aria-labelledby="articles-title">
		<div class="section-command">
			<span aria-hidden="true">&gt;</span>
			<h2 id="articles-title">ls -lt ./posts</h2>
		</div>

		{
			posts.length > 0 ? (
				<ol class="post-list">
					{posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<time datetime={post.data.pubDate.toISOString()}>
									{post.data.pubDate.toISOString().slice(0, 10)}
								</time>
								<span class="post-copy">
									<strong>{post.data.title}</strong>
									<span>{post.data.description}</span>
								</span>
								<span class="open" aria-hidden="true">-&gt;</span>
							</a>
						</li>
					))}
				</ol>
			) : (
				<p class="empty-state">
					<span>total 0</span>
					No entries yet. The cursor is blinking.
				</p>
			)
		}
	</section>
</BaseLayout>

<style>
	.intro {
		max-width: 46rem;
		padding: clamp(2rem, 8vw, 6rem) 0 clamp(4rem, 10vw, 7rem);
	}

	.command,
	.section-command {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin: 0 0 1.25rem;
		color: var(--gold);
		font-size: 0.875rem;
		font-weight: 700;
		letter-spacing: 0.04em;
	}

	.command span,
	.section-command > span {
		color: var(--foam);
	}

	h1 {
		max-width: max-content;
		margin: 0;
		color: var(--text);
		font-size: clamp(3rem, 10vw, 6.5rem);
		letter-spacing: -0.08em;
		line-height: 0.95;
	}

	h1::after {
		display: inline-block;
		width: 0.12em;
		height: 0.8em;
		margin-left: 0.12em;
		background: var(--iris);
		content: '';
		vertical-align: -0.04em;
		animation: blink 1.1s steps(1) infinite;
	}

	.lede {
		max-width: 40rem;
		margin: 1.75rem 0 0;
		color: var(--muted);
		font-size: clamp(1rem, 2.5vw, 1.2rem);
		line-height: 1.8;
	}

	.section-command {
		margin-bottom: 0.75rem;
	}

	.section-command h2 {
		margin: 0;
		color: var(--gold);
		font-size: inherit;
		letter-spacing: inherit;
	}

	.post-list {
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--border);
		list-style: none;
	}

	.post-list li {
		border-bottom: 1px solid var(--border);
	}

	.post-list a {
		display: grid;
		grid-template-columns: 8rem minmax(0, 1fr) auto;
		gap: 1.5rem;
		align-items: start;
		padding: 1.75rem 1rem;
		color: inherit;
		text-decoration: none;
		transition: background-color 150ms ease, padding 150ms ease;
	}

	.post-list a:hover,
	.post-list a:focus-visible {
		padding-left: 1.4rem;
		background: var(--highlight-low);
	}

	.post-list a:focus-visible {
		outline: 2px solid var(--iris);
		outline-offset: -2px;
	}

	.post-list time {
		padding-top: 0.2rem;
		color: var(--muted);
		font-size: 0.8rem;
		font-variant-numeric: tabular-nums;
	}

	.post-copy {
		display: grid;
		gap: 0.65rem;
	}

	.post-copy strong {
		color: var(--iris);
		font-size: clamp(1.15rem, 3vw, 1.5rem);
		letter-spacing: -0.03em;
		line-height: 1.35;
	}

	.post-copy > span {
		max-width: 44rem;
		color: var(--muted);
		font-size: 0.9rem;
		line-height: 1.7;
	}

	.open {
		padding-top: 0.1rem;
		color: var(--foam);
		font-weight: 700;
	}

	.empty-state {
		display: grid;
		gap: 1rem;
		margin: 0;
		padding: 2rem 1rem;
		border-block: 1px solid var(--border);
		color: var(--muted);
	}

	.empty-state span {
		color: var(--foam);
		font-size: 0.8rem;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		h1::after {
			animation: none;
		}
	}

	@media (max-width: 640px) {
		.intro {
			padding-top: 3.5rem;
		}

		h1 {
			font-size: clamp(2.8rem, 17vw, 4.5rem);
		}

		.post-list a {
			grid-template-columns: 1fr auto;
			gap: 0.75rem 1rem;
			padding-inline: 0;
		}

		.post-list a:hover,
		.post-list a:focus-visible {
			padding-left: 0.75rem;
		}

		.post-list time {
			grid-column: 1 / -1;
		}
	}
</style>
